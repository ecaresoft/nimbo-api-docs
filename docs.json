{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Nimbo API",
  "description": "Developer documentation for Nimbo integrations, API contracts, and webhooks.",
  "colors": {
    "primary": "#1f87ff",
    "light": "#4da3ff",
    "dark": "#0d6efd"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "navbar": {
    "links": [
      {
        "label": "Contact Nimbo",
        "href": "https://www.nimbo-x.com/contacto"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Nimbo",
      "href": "https://app.nimbo-x.com"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "Patient portal",
            "pages": [
              "guides/patient-portal"
            ]
          },
          {
            "group": "Using the reference",
            "pages": [
              "reference/overview"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Catalogs and sites",
            "openapi": "openapi/nimbo_public.yml"
          },
          {
            "group": "Patient portal",
            "openapi": "openapi/nimbo_patient_portal.yml",
            "pages": [
              {
                "group": "Patient authentication",
                "pages": [
                  "POST /api/v1/patient_portal/auth",
                  "POST /api/v1/patient_portal/validate"
                ]
              },
              {
                "group": "Patient records",
                "pages": [
                  "GET /api/v1/patient_portal/people",
                  "GET /api/v1/patient_portal/people/{person_id}/organization",
                  "GET /api/v1/patient_portal/people/{person_id}/medical_history",
                  "GET /api/v1/patient_portal/people/{person_id}/vital_signs",
                  "GET /api/v1/patient_portal/people/{person_id}/lab_tests",
                  "GET /api/v1/patient_portal/people/{person_id}/attachments",
                  "GET /api/v1/patient_portal/people/{person_id}/consultations",
                  "GET /api/v1/patient_portal/people/{person_id}/prescriptions"
                ]
              },
              {
                "group": "Patient appointments",
                "pages": [
                  "GET /api/v1/patient_portal/people/{person_id}/consultation_schedules",
                  "GET /api/v1/patient_portal/people/{person_id}/consultation_requests",
                  "GET /api/v1/patient_portal/people/{person_id}/organization_portals"
                ]
              }
            ]
          },
          {
            "group": "Core API",
            "openapi": "openapi/nimbo_api.yml"
          },
          {
            "group": "ERP",
            "openapi": "openapi/nimbo_erp.yml"
          },
          {
            "group": "Billing",
            "openapi": "openapi/nimbo_facturacion.yml"
          },
          {
            "group": "Webhooks",
            "openapi": "openapi/nimbo_webhooks.yml"
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Nimbo help center",
          "href": "https://help.nimbo-x.com",
          "icon": "book-open"
        }
      ]
    }
  },
  "api": {
    "playground": {
      "display": "simple"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://twitter.com/nimbo_x",
      "linkedin": "https://www.linkedin.com/company/ecaresoft-inc."
    }
  },
  "redirects": [
    {
      "source": "/reference/public-preview",
      "destination": "/reference/overview",
      "permanent": true
    }
  ]
}
